# Copy to secrets.toml and fill in your own values. Do not commit secrets.toml.

# Free API key from https://data.gov.in (My Account -> API key)
DATA_GOV_API_KEY = "your-data-gov-in-key"

# Optional data.gov.in resource; the default is the Agmarknet daily prices resource.
# DATA_GOV_RESOURCE_ID = "9ef84268-d588-465a-a308-a864a43d0070"

# Turso Cloud database URL and token. Without these, a local libSQL file is used.
# TURSO_DATABASE_URL = "libsql://your-database.turso.io"
# TURSO_AUTH_TOKEN = "your-turso-token"
